[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/hub/field_hub.gd" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/Inter-SemiBold.ttf" id="font_semi"]

[node name="FieldHub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.980392, 0.976471, 0.972549, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Back" type="Button" parent="Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 0
text = "←  Main Menu"

[node name="Eyebrow" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.698039, 0.133333, 0.133333, 1)
theme_override_fonts/font = ExtResource("font_semi")
theme_override_font_sizes/font_size = 14
text = "OOPA VIRTUAL LABS  ·  LABORATORY"
uppercase = true

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.105882, 0.105882, 0.105882, 1)
theme_override_font_sizes/font_size = 44
text = "Chemistry"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "Matter, reactions, equilibrium and energy"

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Grid" type="GridContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 18
columns = 2

[connection signal="pressed" from="Margin/VBox/Back" to="." method="_on_back_pressed"]
