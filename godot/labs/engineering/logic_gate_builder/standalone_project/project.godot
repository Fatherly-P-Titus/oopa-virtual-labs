config_version=5

[application]
config/name="OOPA Logic Gate Builder"
config/description="Standalone digital logic laboratory for OOPA Virtual Labs."
config/version="0.1.0"
run/main_scene="res://scenes/logic_gate_builder_lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.035, 0.04, 1)
